{
  "id": "conv_ch11_peeves_corridor",
  "title": "Chapter 11 — Peeves Knows a Song",
  "placeholder": false,
  "startLineId": "l1",
  "lines": [
    { "id": "l1", "speakerId": "gloria", "text": "Wonderful.", "nextLineId": "l2" },
    { "id": "l2", "speakerId": "gloria", "text": "My next witness is Peeves.", "nextLineId": "l3" },
    { "id": "l3", "speakerId": "gloria", "text": "I hate it already.", "nextLineId": "l4" },
    { "id": "l4", "speakerId": "peeves", "text": "Look out below!", "nextLineId": "l5" },
    { "id": "l5", "speakerId": "peeves", "text": "Ooooh. New detective.", "nextLineId": "l6" },
    { "id": "l6", "speakerId": "peeves", "text": "This should be fun.", "nextLineId": "l7" },
    { "id": "l7", "speakerId": "peeves", "text": "Well, well. Professor Binnsy sends a detective!", "nextLineId": "l8" },
    { "id": "l8", "speakerId": "gloria", "text": "You're hard to miss.", "nextLineId": "l9" },
    { "id": "l9", "speakerId": "peeves", "text": "And yet everyone keeps trying.", "nextLineId": "l10" },
    {
      "id": "l10",
      "speakerId": "gloria",
      "text": "Professor Binns said you might know something about the Silent Lion.",
      "nextLineId": "l11"
    },
    { "id": "l11", "speakerId": "peeves", "text": "History! The most dangerous kind of boredom!", "nextLineId": "l12" },
    { "id": "l12", "speakerId": "gloria", "text": "The Silent Lion.", "nextLineId": "l13" },
    { "id": "l13", "speakerId": "peeves", "text": "Quiet kitty!", "nextLineId": "l14" },
    { "id": "l14", "speakerId": "gloria", "text": "That's not helpful.", "nextLineId": "l15" },
    { "id": "l15", "speakerId": "peeves", "text": "Neither am I! Mostly.", "nextLineId": "l16" },
    { "id": "l16", "speakerId": "peeves", "text": "Lion waits and eagle sees.", "nextLineId": "l17" },
    { "id": "l17", "speakerId": "peeves", "text": "Badger keeps and serpent weighs.", "nextLineId": "l18" },
    { "id": "l18", "speakerId": "peeves", "text": "Four may knock but one may walk.", "nextLineId": "l19" },
    {
      "id": "l19",
      "speakerId": "peeves",
      "text": "Ask the man who never talks.",
      "journalUpdates": [{ "entryId": "journal_lion_rhyme", "stage": 0 }],
      "nextLineId": "l20"
    },
    { "id": "l20", "speakerId": "gloria", "text": "Where did you hear that?", "nextLineId": "l21" },
    { "id": "l21", "speakerId": "peeves", "text": "Everywhere. Nowhere.", "nextLineId": "l22" },
    {
      "id": "l22",
      "speakerId": "peeves",
      "text": "Students sang it. Professors ignored it. Portraits hated it.",
      "nextLineId": "l23"
    },
    { "id": "l23", "speakerId": "gloria", "text": "What does it mean?", "nextLineId": "l24" },
    { "id": "l24", "speakerId": "peeves", "text": "Means what it means.", "nextLineId": "l25" },
    { "id": "l25", "speakerId": "gloria", "text": "Helpful.", "nextLineId": "l26" },
    { "id": "l26", "speakerId": "peeves", "text": "Path people always asked that.", "nextLineId": "l27" },
    { "id": "l27", "speakerId": "gloria", "text": "Path people?", "nextLineId": "l28" },
    { "id": "l28", "speakerId": "peeves", "text": "Walkers.", "nextLineId": "l29" },
    { "id": "l29", "speakerId": "gloria", "text": "Walkers of what?", "nextLineId": "l30" },
    { "id": "l30", "speakerId": "peeves", "text": "The Path.", "nextLineId": "l31" },
    { "id": "l31", "speakerId": "gloria", "text": "Professor Binns mentioned that name.", "nextLineId": "l32" },
    { "id": "l32", "speakerId": "peeves", "text": "Course he did. Binnsy remembers everything.", "nextLineId": "l33" },
    { "id": "l33", "speakerId": "gloria", "text": "What is the Path?", "nextLineId": "l34" },
    { "id": "l34", "speakerId": "peeves", "text": "Was.", "nextLineId": "l35" },
    { "id": "l35", "speakerId": "gloria", "text": "Fine. What was the Path?", "nextLineId": "l36" },
    { "id": "l36", "speakerId": "peeves", "text": "A place.", "nextLineId": "l37" },
    { "id": "l37", "speakerId": "gloria", "text": "That's not helpful either.", "nextLineId": "l38" },
    { "id": "l38", "speakerId": "peeves", "text": "Didn't say it was.", "nextLineId": "l39" },
    { "id": "l39", "speakerId": "gloria", "text": "Where?", "nextLineId": "l40" },
    { "id": "l40", "speakerId": "peeves", "text": "Behind the paintings.", "nextLineId": "l41" },
    { "id": "l41", "speakerId": "gloria", "text": "Behind the paintings?", "nextLineId": "l42" },
    { "id": "l42", "speakerId": "peeves", "text": "Oops.", "nextLineId": "l43" },
    {
      "id": "l43",
      "speakerId": "peeves",
      "text": "Anyway! Have you seen Filch lately? I hid his keys in a tuba.",
      "nextLineId": "l44"
    },
    { "id": "l44", "speakerId": "gloria", "text": "Did you know Professor Ashcombe?", "nextLineId": "l45" },
    { "id": "l45", "speakerId": "peeves", "text": "Professor Dusty?", "nextLineId": "l46" },
    { "id": "l46", "speakerId": "gloria", "text": "Professor Ashcombe.", "nextLineId": "l47" },
    {
      "id": "l47",
      "speakerId": "peeves",
      "text": "Dusty. Always carrying books. Always looking at walls. Never appreciated good mischief.",
      "nextLineId": "l48"
    },
    { "id": "l48", "speakerId": "gloria", "text": "Did you see him before he died?", "nextLineId": "l49" },
    { "id": "l49", "speakerId": "peeves", "text": "Saw him lots. Saw somebody else too.", "nextLineId": "l50" },
    { "id": "l50", "speakerId": "gloria", "text": "Who?", "nextLineId": "l51" },
    { "id": "l51", "speakerId": "peeves", "text": "Stone fixer.", "nextLineId": "l52" },
    { "id": "l52", "speakerId": "gloria", "text": "Gideon?", "nextLineId": "l53" },
    {
      "id": "l53",
      "speakerId": "peeves",
      "text": "Old Stone Fixer. Walking where he shouldn't.",
      "nextLineId": "l54"
    },
    { "id": "l54", "speakerId": "gloria", "text": "When?", "nextLineId": "l55" },
    { "id": "l55", "speakerId": "peeves", "text": "Before.", "nextLineId": "l56" },
    { "id": "l56", "speakerId": "gloria", "text": "Before what?", "nextLineId": "l57" },
    { "id": "l57", "speakerId": "peeves", "text": "Before after.", "nextLineId": "l58" },
    { "id": "l58", "speakerId": "gloria", "text": "That isn't a time.", "nextLineId": "l59" },
    { "id": "l59", "speakerId": "peeves", "text": "It is to ghosts.", "nextLineId": "l60" },
    { "id": "l60", "speakerId": "gloria", "text": "The week Ashcombe died?", "nextLineId": "l61" },
    { "id": "l61", "speakerId": "peeves", "text": "Maybe.", "nextLineId": "l62" },
    { "id": "l62", "speakerId": "gloria", "text": "The night he died?", "nextLineId": "l63" },
    { "id": "l63", "speakerId": "peeves", "text": "Maybe.", "nextLineId": "l64" },
    { "id": "l64", "speakerId": "gloria", "text": "You don't know.", "nextLineId": "l65" },
    {
      "id": "l65",
      "speakerId": "peeves",
      "text": "Course I don't know. I never know. I remember.",
      "setFlags": { "peeves_saw_gideon_near_corridor": true },
      "transitionToSceneId": "scene_ashcombe_office"
    }
  ]
}
