    { "id": "l4", "speakerId": "gloria", "text": "That much seems certain.", "nextLineId": "l5" },
    { "id": "l5", "speakerId": "gloria", "text": "But nobody agrees on what it meant.", "nextLineId": "l6" },
    { "id": "l6", "speakerId": "gloria", "text": "Helpful.", "nextLineId": "l7" },
    {
      "id": "l7",
      "speakerId": "gloria",
      "text": "No. Actually, not helpful at all.",
